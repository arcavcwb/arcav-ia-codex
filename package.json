{
  "name": "@arcav-ia/codex",
  "version": "1.2.0",
  "description": "Personal zero-dependency CLI that scaffolds repositories for OpenAI Codex (five agents, eight skills) and runs a deterministic backlog-to-review pipeline",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "arcav-codex": "./bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/cli.js",
    "doctor": "node ./bin/cli.js --doctor",
    "test": "node --test tests/*.test.js",
    "check:design": "bash ./templates/core-skills/impeccable/scripts/impeccable detect"
  },
  "keywords": [
    "codex",
    "openai-codex",
    "ai-agents",
    "cli",
    "template",
    "scaffolding",
    "zero-trust",
    "governance",
    "impeccable",
    "caveman",
    "ponytail"
  ],
  "author": "Arcav IA <arcavcwb@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcavcwb/arcav-ia-codex.git"
  },
  "bugs": {
    "url": "https://github.com/arcavcwb/arcav-ia-codex/issues"
  },
  "homepage": "https://github.com/arcavcwb/arcav-ia-codex#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
